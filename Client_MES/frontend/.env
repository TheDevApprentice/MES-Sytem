# ===========================================
# FICHIER .ENV - ENVIRONNEMENT DÉVELOPPEMENT
# ===========================================

# ⚠️  IMPORTANT: Ce fichier peut être versionné (pas de secrets)
# Pour les secrets, utilisez .env.local (ignoré par git)

# 🔧 CONFIGURATION APPLICATION
NODE_ENV=development
VITE_APP_TITLE="Client MES"
VITE_APP_DESCRIPTION="Client MES"
VITE_APP_VERSION="1.0.0"
VITE_APP_AUTHOR="Hugo Abric"
VITE_TEST_LICENCE="multiCompany"

# 🌍 INTERNATIONALISATION
VITE_DEFAULT_LOCALE=fr
VITE_FALLBACK_LOCALE=en
VITE_AVAILABLE_LOCALES=fr,en,es

# 📊 OUTILS DE DÉVELOPPEMENT
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
ANALYZE=false

# 🚀 PERFORMANCE & CACHE
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_VERSION=1.0.0
VITE_PRELOAD_IMAGES=true
VITE_LAZY_LOADING=true

# 📱 PWA CONFIGURATION
VITE_PWA_ENABLED=true
VITE_PWA_THEME_COLOR=#3b82f6
VITE_PWA_BACKGROUND_COLOR=#ffffff
VITE_PWA_DISPLAY=standalone

# API Configuration
VITE_API_BASE_URL=https://localhost:8443
VITE_API_TIMEOUT=30000

# 📂 CONFIGURATION UPLOAD
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx
VITE_UPLOAD_ENDPOINT=/upload

# 🔄 CONFIGURATION TEMPS RÉEL
VITE_WEBSOCKET_URL=wss://localhost:8443
VITE_WEBSOCKET_RECONNECT_INTERVAL=5000
VITE_ENABLE_REAL_TIME=true

# 🔐 SÉCURITÉ AVANCÉE
VITE_CONTENT_SECURITY_POLICY=false
VITE_ENABLE_XSS_PROTECTION=true
VITE_SECURE_COOKIES=false